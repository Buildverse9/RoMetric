# GEMINI_API_KEY: Required for Gemini AI API calls if added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Connection (Website + Cloudflare Collector)
# Keep all keys strictly server-side (never prefix with NEXT_PUBLIC_).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Optional Tier 2 Warm History (Cloudflare R2 via Worker URL — Server-Side Only, $0 Egress)
# Example: https://rometric-collector.YOUR_SUBDOMAIN.workers.dev
R2_HISTORY_WORKER_URL=""

# Optional BloxArchive JSON API Integration (Server-Side Only — Never prefix with NEXT_PUBLIC_)
# Request a personal API key from BloxArchive and enable the provider in /admin -> Codes.
BLOXARCHIVE_API_KEY=""
BLOXARCHIVE_API_BASE_URL=""

# Optional SEO & Website Traffic Analytics (Safe Client-Side Public IDs)
# Google Tag Manager Container ID (defaults to GTM-5B3QCDG2)
NEXT_PUBLIC_GTM_ID="GTM-5B3QCDG2"
# Optional direct Google Analytics 4 Measurement ID (leave blank if GA4 is configured inside GTM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Google Search Console HTML Meta Verification Token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
