# GEMINI_API_KEY: Required for Gemini AI API calls if added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional External Production Deployment Variables (Supabase + Cloudflare)
# Keep these strictly server-side (never prefix with NEXT_PUBLIC_).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
